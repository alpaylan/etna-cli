      { "name": "stlc-haskell",     "url": "https://github.com/alpaylan/etna-haskell-stlc" },
      { "name": "fsub-haskell",     "url": "https://github.com/alpaylan/etna-haskell-fsub" },
      { "name": "luparser-haskell", "url": "https://github.com/alpaylan/etna-haskell-luparser" }
    ],
    "OCaml": [
      { "name": "bst-ocaml",  "url": "https://github.com/alpaylan/etna-ocaml-bst" },
      { "name": "rbt-ocaml",  "url": "https://github.com/alpaylan/etna-ocaml-rbt" },
      { "name": "stlc-ocaml", "url": "https://github.com/alpaylan/etna-ocaml-stlc" },
      { "name": "rare-ocaml", "url": "https://github.com/alpaylan/etna-ocaml-rare" }
    ],
    "Python": [
      { "name": "bst-python", "url": "https://github.com/alpaylan/etna-python-bst" }
    ],
    "Racket": [
      { "name": "bst-racket",     "url": "https://github.com/alpaylan/etna-racket-bst" },
      { "name": "rbt-racket",     "url": "https://github.com/alpaylan/etna-racket-rbt" },
