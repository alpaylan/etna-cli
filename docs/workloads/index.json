      { "name": "RBT",      "url": "https://github.com/alpaylan/etna-haskell-rbt" },
      { "name": "STLC",     "url": "https://github.com/alpaylan/etna-haskell-stlc" },
      { "name": "FSUB",     "url": "https://github.com/alpaylan/etna-haskell-fsub" },
      { "name": "LuParser", "url": "https://github.com/alpaylan/etna-haskell-luparser" }
    ],
    "OCaml": [
      { "name": "BST",  "url": "https://github.com/alpaylan/etna-ocaml-bst" },
      { "name": "RBT",  "url": "https://github.com/alpaylan/etna-ocaml-rbt" },
      { "name": "STLC", "url": "https://github.com/alpaylan/etna-ocaml-stlc" },
      { "name": "RARE", "url": "https://github.com/alpaylan/etna-ocaml-rare" }
    ],
    "Python": [
      { "name": "bst", "url": "https://github.com/alpaylan/etna-python-bst" }
    ],
    "Racket": [
      { "name": "BST",     "url": "https://github.com/alpaylan/etna-racket-bst" },
