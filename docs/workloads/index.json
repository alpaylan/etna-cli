  "notes": {
    "crate-fork": "Entries tagged `crate-fork` are forks of real Rust crates with Etna variants declared in `etna.toml` as `[[variant]]` tables. They resolve by name like any other entry, but the current CLI's `WorkloadManifest` parser does not yet understand variant-style manifests, so `etna workload add` will fail at validation.",
    "wip": "Entries marked `wip` do not yet have a valid `etna.toml` / `steps.json` and cannot be added."
