{
  "setup_steps": [],
  "build_steps": [
    {
      "Command": {
        "command": "cargo",
        "args": [
          "build",
          "--release",
          "--manifest-path",
          "${workload_path}/../harness/Cargo.toml"
        ],
        "params": ["workload_path"]
      }
    }
  ],
  "tags": {},
  "capabilities": {
    "solve": [
      {
        "Command": {
          "command": "${workload_path}/../harness/target/release/etna_test_harness",
          "args": ["solve", "--property", "${property}"],
          "params": ["workload_path", "property"]
        }
      }
    ],
    "sample": [
      {
        "Command": {
          "command": "${workload_path}/../harness/target/release/etna_test_harness",
          "args": ["sample", "--trials", "3"],
          "params": ["workload_path"]
        }
      }
    ],
    "test": [
      {
        "Command": {
          "command": "${workload_path}/../harness/target/release/etna_test_harness",
          "args": ["test", "--property", "${property}", "--inputs", "${inputs}"],
          "params": ["workload_path", "property", "inputs"]
        }
      }
    ],
    "shrink": [
      {
        "Command": {
          "command": "${workload_path}/../harness/target/release/etna_test_harness",
          "args": ["shrink", "--property", "${property}", "--counterexample", "${counterexample}"],
          "params": ["workload_path", "property", "counterexample"]
        }
      }
    ]
  }
}
