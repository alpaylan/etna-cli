{
  "setup_steps": [],
  "build_steps": [
    {
      "Command": {
        "command": "cargo",
        "args": [
          "build",
          "--release"
        ]
      }
    }
  ],
  "capabilities": {
    "solve": [
      {
        "Command": {
          "command": "${workload_path}/target/release/rbt",
          "args": [
            "${strategy}",
            "${property}"
          ],
          "params": [
            "workload_path",
            "property",
            "strategy"
          ]
        }
      }
    ],
    "sample": [
      {
        "Command": {
          "command": "${workload_path}/target/release/rbt-sampler",
          "args": [
            "${strategy}",
            "${property}",
            "${tests}"
          ],
          "params": [
            "workload_path",
            "property",
            "strategy"
          ]
        }
      }
    ]
  }
}
