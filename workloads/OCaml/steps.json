{
  "setup_steps": [
    {
      "Command": {
        "command": "dune",
        "args": [
          "--version"
        ]
      }
    },
    {
      "Command": {
        "command": "opam",
        "args": [
          "--version"
        ]
      }
    }
  ],
  "build_steps": [
    {
      "Command": {
        "command": "opam",
        "args": [
          "switch"
        ]
      }
    },
    {
      "Command": {
        "command": "opam",
        "args": [
          "exec",
          "--",
          "dune",
          "build"
        ]
      }
    }
  ],
  "capabilities": {
    "solve": [
      {
        "Command": {
          "run_at": "${workload_path}",
          "command": "opam",
          "args": [
            "exec",
            "--",
            "dune",
            "exec",
            "bst",
            "--",
            "--property=$property",
            "--strategy=${strategy}"
          ]
        }
      }
    ],
    "sample": [
      {
        "Command": {
          "run_at": "${workload_path}",
          "command": "opam",
          "args": [
            "exec",
            "--",
            "dune",
            "exec",
            "bst-sampler",
            "--",
            "--property=$property",
            "--strategy=${strategy}",
            "--count=$tests"
          ]
        }
      }
    ]
  }
}
